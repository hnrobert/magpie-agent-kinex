{
  "name": "magpie-agent-kinex",
  "version": "0.1.0",
  "description": "Bring Kinex into magpie's Agents list: pick a model for Kinex in magpie and the plugin writes it into Kinex's models.json and settings.json",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/hnrobert/magpie-agent-kinex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hnrobert/magpie-agent-kinex.git"
  },
  "bugs": {
    "url": "https://github.com/hnrobert/magpie-agent-kinex/issues"
  },
  "packageManager": "pnpm@11.13.0",
  "files": [
    "kinex.agent.js",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-agent",
    "kinex",
    "robotics",
    "pi",
    "llm-gateway"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "prettier --check . && eslint . && pnpm test"
  },
  "magpie": {
    "agent": "./kinex.agent.js",
    "name": "Kinex",
    "icon": "https://raw.githubusercontent.com/hnrobert/magpie-agent-kinex/main/assets/kinex-logo.svg",
    "summary": {
      "en": "Kinex, the robotics coding agent built on Pi, in magpie's Agents list: pick a model there and the plugin writes it into Kinex's models.json and settings.json."
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
